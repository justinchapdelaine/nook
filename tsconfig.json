{
  "extends": "./bench/.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["chrome", "@webgpu/types", "node"],
    "resolveJsonModule": true
  },
  "include": [
    "extension/**/*",
    "extension/.wxt/wxt.d.ts",
    "bench/**/*",
    "bench/.wxt/wxt.d.ts",
    "scripts/**/*",
    "tests/**/*",
    "*.config.ts"
  ],
  "exclude": ["extension/.output", "extension/.wxt", "bench/.output", "bench/.wxt"]
}
