{
  "name": "nook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.8",
    "@types/node": "^26.6.11",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.89"
  },
  "scripts": {
    "fetch:libs": "node scripts/fetch-model-libs.ts",
    "prepare": "wxt prepare bench",
    "dev": "wxt bench",
    "build": "npm run fetch:libs && wxt build bench",
    "zip": "npm run fetch:libs && wxt zip bench",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --trace off"
  }
}
